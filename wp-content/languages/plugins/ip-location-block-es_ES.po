#: admin/includes/tab-geolocation.php:101 admin/includes/tab-settings.php:1127
msgid "<dfn title=\"IP address is always encrypted on recording in Cache and Logs. Moreover, this option replaces the end of IP address with &#8220;***&#8221; to make it anonymous.\">Anonymize IP address</dfn>"
msgstr "<dfn title=\"La dirección IP se encripta siempre cuando se guarda en la caché y en los registros. Además, esta opción reemplaza el final de la dirección IP por «***» para hacerla anónima.\">Anonimizar la dirección IP</dfn>"

#: admin/includes/tab-settings.php:1142
msgid "<dfn title=\"This option restricts not to send IP address to the external Geolocation APIs.\">Do not send IP address to external APIs</dfn>"
msgstr "<dfn title=\"Esta opción impide el envío de direcciones IP a las API de geolocalización externas.\">No enviar la dirección IP a API externas</dfn>"

#: admin/includes/tab-settings.php:1157
msgid "<dfn title=\"This option enables to record the IP address, country code and failure counter of login attempts into the cache on database to minimize the impact on site speed.\">Record &#8220;IP address cache&#8221;</dfn>"
msgstr "<dfn title=\"Esta opción permite guardar la dirección IP, el código de país y la cantidad de intentos de acceso fallidos en la caché en la base de datos para minimizar el impacto en la velocidad del sitio.\">Guardar en la «Caché de direcciones IP»</dfn>"

#: admin/includes/tab-settings.php:1172
msgid "<dfn title=\"If user authentication fails consecutively beyond &#8220;Max number of failed login attempts per IP address&#8221;, subsequent login will also be prohibited for this period.\">Expiration time [sec] for each entry</dfn>"
msgstr "<dfn title=\"Si la identificación del usuario falla consecutivamente por más del «Número máximo de intentos de acceso fallidos por dirección IP», también se prohibirá el acceso posterior por este período.\">Tiempo de caducidad [segundos] para cada entrada</dfn>"

#: admin/includes/tab-settings.php:1188
msgid "<dfn title=\"This option enables to record the validation logs including IP addresses.\">Record &#8220;Validation logs&#8221;</dfn>"
msgstr "<dfn title=\"Esta opción permite guardar los registros de validación, incluidas las direcciones IP.\">Guardar en «Registros de validación»</dfn>"

